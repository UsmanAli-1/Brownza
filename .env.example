# Copy to .env.local and fill in real values.

# ---- Business contact (client-exposed) ----
NEXT_PUBLIC_PHONE_NUMBER=03719132611
NEXT_PUBLIC_WHATSAPP_NUMBER=03719132611

# ---- Delivery (client-exposed) ----
NEXT_PUBLIC_DELIVERY_CHARGE=250

# ---- Bank details for online payment (client-exposed; shown at checkout) ----
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=99510104996453
NEXT_PUBLIC_BANK_ACCOUNT_TITLE=Masters Collection
NEXT_PUBLIC_BANK_NAME=Meezan Bank

# ---- MongoDB Atlas (server-only) ----
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/brownza?appName=Cluster0

# ---- Admin auth (server-only) ----
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ---- Cloudinary (server-only; payment screenshots only) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
