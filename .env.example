# Copy to .env.local for local development.

# Business phone / WhatsApp (local Pakistani format). WhatsApp links are
# derived from the number automatically.
NEXT_PUBLIC_PHONE_NUMBER=03719132611
NEXT_PUBLIC_WHATSAPP_NUMBER=03719132611

# Flat delivery charge (PKR) applied below the free-delivery threshold.
NEXT_PUBLIC_DELIVERY_CHARGE=250
# Subtotal (PKR) at/above which delivery is free. Set to 0 to disable.
NEXT_PUBLIC_FREE_DELIVERY_THRESHOLD=2500
